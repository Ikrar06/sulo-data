{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skema": {
      "type": "number",
      "const": 1
    },
    "tahun_ajaran": {
      "type": "string",
      "pattern": "^\\d{4}\\/\\d{4}$"
    },
    "revisi": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "diperbarui": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "diverifikasi_pada": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "berlaku_mulai": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "berlaku_sampai": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "zona_waktu": {
      "type": "string",
      "const": "Asia/Makassar"
    },
    "sumber": {
      "type": "object",
      "properties": {
        "judul": {
          "type": "string",
          "minLength": 1
        },
        "sk": {
          "type": "string",
          "minLength": 1
        },
        "pdf_url": {
          "type": "string",
          "format": "uri"
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "halaman_url": {
          "type": "string",
          "format": "uri"
        },
        "ics_diunduh_pada": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "judul",
        "sk",
        "pdf_url",
        "pdf_sha256",
        "halaman_url",
        "ics_diunduh_pada"
      ]
    },
    "kegiatan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "semester": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "awal",
                  "akhir"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "kategori": {
            "type": "string",
            "enum": [
              "jadwal",
              "krs",
              "perkuliahan",
              "uts",
              "uas",
              "libur",
              "nilai",
              "sanggah",
              "evaluasi",
              "kkn",
              "wisuda",
              "administrasi",
              "penerimaan",
              "lainnya"
            ]
          },
          "judul": {
            "type": "string",
            "minLength": 1
          },
          "mulai": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "selesai": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "ujung_terbuka": {
            "default": false,
            "type": "boolean"
          },
          "perkiraan": {
            "default": false,
            "type": "boolean"
          },
          "audiens": {
            "type": "string",
            "enum": [
              "mahasiswa",
              "calon_mahasiswa",
              "umum"
            ]
          },
          "jenjang": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "semua",
                "S1",
                "D4",
                "S2",
                "S3",
                "profesi",
                "spesialis"
              ]
            }
          },
          "status_verifikasi": {
            "type": "string",
            "enum": [
              "cocok_ics_pdf",
              "cocok_pdf",
              "cocok_skb",
              "perlu_cek"
            ]
          },
          "asal": {
            "type": "string",
            "enum": [
              "ics",
              "pdf"
            ]
          },
          "nilai_lain": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mulai": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "selesai": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sumber": {
                  "type": "string",
                  "minLength": 1
                },
                "catatan": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "mulai",
                "selesai",
                "sumber"
              ]
            }
          },
          "rincian": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "catatan": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "semester",
          "kategori",
          "judul",
          "mulai",
          "selesai",
          "audiens",
          "jenjang",
          "status_verifikasi",
          "asal"
        ]
      }
    },
    "libur_nasional": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nama": {
            "type": "string",
            "minLength": 1
          },
          "mulai": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "selesai": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "jenis": {
            "type": "string",
            "enum": [
              "libur_nasional",
              "cuti_bersama"
            ]
          },
          "status_verifikasi": {
            "type": "string",
            "enum": [
              "cocok_ics_pdf",
              "cocok_pdf",
              "cocok_skb",
              "perlu_cek"
            ]
          },
          "catatan": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nama",
          "mulai",
          "selesai",
          "jenis",
          "status_verifikasi"
        ]
      }
    },
    "pekan": {
      "type": "object",
      "properties": {
        "awal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pekan": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nomor": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mulai": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "nomor",
                      "mulai"
                    ]
                  }
                },
                "dikecualikan": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "mulai": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "alasan": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "mulai",
                      "alasan"
                    ]
                  }
                },
                "uts_pekan": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "uas_pekan": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "catatan": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "pekan",
                "uts_pekan",
                "uas_pekan"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "akhir": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pekan": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nomor": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mulai": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "nomor",
                      "mulai"
                    ]
                  }
                },
                "dikecualikan": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "mulai": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "alasan": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "mulai",
                      "alasan"
                    ]
                  }
                },
                "uts_pekan": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "uas_pekan": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "catatan": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "pekan",
                "uts_pekan",
                "uas_pekan"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "awal",
        "akhir"
      ]
    }
  },
  "required": [
    "skema",
    "tahun_ajaran",
    "revisi",
    "diperbarui",
    "diverifikasi_pada",
    "berlaku_mulai",
    "berlaku_sampai",
    "zona_waktu",
    "sumber",
    "kegiatan",
    "libur_nasional",
    "pekan"
  ],
  "title": "Sulo academic calendar",
  "$id": "https://ikrar06.github.io/sulo-data/schema/calendar.schema.json"
}
